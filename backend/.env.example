# ===========================================
# LENA Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- PubMed / NCBI ---
# Free but recommended: register at https://www.ncbi.nlm.nih.gov/account/
# Gets you 10 requests/sec instead of 3/sec
NCBI_API_KEY=your-ncbi-api-key-here
NCBI_EMAIL=your-email@example.com

# --- App Config ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Auth (JWT) ---
# Tokens expire after 7 days by default (10080 minutes). Users stay signed in until logout or expiry.
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRATION_MINUTES=10080

# --- Internal testers (full access — no plan caps, no content gates) ---
# Comma-separated UUIDs and/or exact login emails (no wildcards).
# BYPASS_USER_IDS=
# BYPASS_USER_EMAILS=mark.e.s.thompson@gmail.com,lauren@capitalfive.co.za

# --- Email (Resend) ---
RESEND_API_KEY=re_your-resend-api-key-here

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Phase-2 sources (fail loud in production for Synapse) ---
# SYNAPSE_API_TOKEN=your-synapse-personal-access-token
# LENA_REQUIRE_SOURCE_KEYS=false  # set true to force fail-loud outside production

# --- Stripe (Phase 4/5 — TEST MODE Price IDs first) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_RESEARCHER_MONTHLY=price_...
# STRIPE_PRICE_RESEARCHER_ANNUAL=price_...
# STRIPE_PRICE_PRO_49_MONTHLY=price_...
# STRIPE_PRICE_PRO_49_ANNUAL=price_...
# STRIPE_PRICE_PRO_FOUNDING=price_...
# Keep legacy $19 Price IDs until cutover (map to Researcher):
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...

# --- Railway (Auto-set by Railway, do not set manually) ---
# PORT=8000
# RAILWAY_ENVIRONMENT=production
